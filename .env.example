# ============================================================
# SkillSense Production Environment Configuration Template
# Copy this file to .env and replace all placeholders with real values.
# NEVER COMMIT THE ACTUAL .env FILE TO GIT.
# ============================================================

# Flask Application
SECRET_KEY=your_secure_random_flask_secret_key_here
FLASK_ENV=production
SESSION_LIFETIME_HOURS=24

# PostgreSQL Database (Authoritative Production Source of Truth)
# You can provide either the full connection URL or individual connection parameters:
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name
DB_NAME=skillsense
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_RETENTION_HOURS=24

# AI & LLM Service Credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HF_TOKEN=your_huggingface_token_here
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
USE_LLM_RETRIEVAL=true

# Razorpay Payment Gateway (Live credentials in production)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# SMTP Email Configuration (For OTP, Password Resets & Admin Invitations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email_address@example.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM=your_email_address@example.com
# Optional: Destination email for contact form inquiries (defaults to SMTP_FROM / SMTP_USER if not set)
CONTACT_RECEIVER_EMAIL=support@yourdomain.com

# CORS & Domain Configuration
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
